<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="SourceGit.Views.GitProviderSettings"
             x:DataType="vm:GitProviderAccounts">
  <Grid Margin="0,8,0,16" MinHeight="400" ColumnDefinitions="260,*">
    <Border Grid.Column="0"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}">
      <Grid RowDefinitions="*,1,Auto">
        <ListBox Grid.Row="0"
                 x:Name="AccountList"
                 Background="Transparent"
                 ItemsSource="{Binding Accounts}"
                 SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="m:GitProviderAccount">
              <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource Brush.Border2}" HorizontalAlignment="Stretch"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Background="{DynamicResource Brush.ToolBar}">
          <Button Classes="icon_button" Click="OnRemoveAccount">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Minus}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Vertical" MaxWidth="400">
      <TextBlock Classes="bold" Text="Add account"/>

      <TextBlock Margin="0,12,0,0" Text="Provider"/>
      <ComboBox x:Name="CmbProvider" Margin="0,4,0,0" Height="28" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnProviderChanged">
        <ComboBoxItem Content="GitHub"/>
        <ComboBoxItem Content="GitLab (gitlab.com)"/>
        <ComboBoxItem Content="GitLab (self-hosted)"/>
      </ComboBox>

      <StackPanel x:Name="HostPanel" IsVisible="False">
        <TextBlock Margin="0,12,0,0" Text="Server URL"/>
        <TextBox x:Name="TxtHost" Margin="0,4,0,0" Height="28" CornerRadius="3" Watermark="https://gitlab.example.com"/>
      </StackPanel>

      <TextBlock Margin="0,12,0,0" Text="Personal access token"/>
      <TextBox x:Name="TxtToken" Margin="0,4,0,0" Height="28" CornerRadius="3" PasswordChar="*"/>
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                 Text="GitHub: scope 'repo'. GitLab: scopes 'read_api' and 'read_repository' (plus 'write_repository' to push)."/>

      <Button Margin="0,12,0,0" Classes="flat" Height="28" Content="Sign in" Click="OnAddAccount"/>
      <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
